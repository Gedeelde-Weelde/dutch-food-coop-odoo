<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add discount info columns to the POS order form line tree -->
    <record id="view_pos_order_form_discount_info" model="ir.ui.view">
        <field name="name">pos.order.form.discount.info</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/tree//field[@name='price_unit']"
                   position="after">
                <field name="original_price"
                       string="List Price"
                       optional="show"
                       widget="monetary"/>
                <field name="discounted_price"
                       string="Pricelist Price"
                       optional="show"
                       widget="monetary"/>
                <field name="discount_total"
                       string="Discount Total"
                       optional="show"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>

    <!-- Add sum to discount_total field -->
    <record id="view_pos_order_form_discount_total_sum" model="ir.ui.view">
        <field name="name">pos.order.form.discount.total.sum</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="view_pos_order_form_discount_info"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/tree//field[@name='discount_total']"
                   position="attributes">
                <attribute name="sum">Total Discount</attribute>
            </xpath>
        </field>
    </record>

</odoo>
