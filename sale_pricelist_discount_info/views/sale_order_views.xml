<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add discount info columns to the sale order form line tree -->
    <record id="view_order_form_discount_info" model="ir.ui.view">
        <field name="name">sale.order.form.discount.info</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']"
                   position="after">
                <field name="original_price"
                       string="List Price"
                       optional="show"
                       widget="monetary"/>
                <field name="discounted_price"
                       string="Pricelist Price"
                       optional="show"
                       widget="monetary"/>
                <field name="discount_total"
                       string="Discount Total"
                       optional="show"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>

    <!-- Also add to the quotation form (same base view, but let's be explicit) -->
    <record id="view_quotation_form_discount_info" model="ir.ui.view">
        <field name="name">sale.order.quotation.form.discount.info</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='discount_total']"
                   position="attributes">
                <attribute name="sum">Total Discount</attribute>
            </xpath>
        </field>
    </record>

</odoo>
