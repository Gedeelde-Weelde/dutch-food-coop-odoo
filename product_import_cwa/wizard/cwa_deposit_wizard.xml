<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form View for the Wizard -->
    <record id="cwa_deposit_wizard_form_view" model="ir.ui.view">
        <field name="name">cwa.deposit.wizard.form</field>
        <field name="model">cwa.deposit.wizard</field>
        <field name="arch" type="xml">
            <form string="CWA Deposit Wizard">
                <sheet>
                    <group>
                        <field name="deposit_price" required="1" />
                        <field name="target_deposit_product_id" required="1" />
                    </group>
                    <footer>
                        <button
                            name="action_apply"
                            type="object"
                            string="Apply"
                            class="btn-primary"
                        />
                        <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for the Wizard -->
    <record id="action_cwa_deposit_wizard" model="ir.actions.act_window">
        <field name="name">CWA Deposit Wizard</field>
        <field name="res_model">cwa.deposit.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cwa_deposit_wizard_form_view" />
        <field name="target">new</field>
        <field name="context" eval="{}" />
    </record>
</odoo>
