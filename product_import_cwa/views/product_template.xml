<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_form_product_extended" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page name="extended_information" string="Extra info">
                    <group name="group_top">
                        <group name="group_left">
                            <field name="kwaliteit" />
                        </group>
                    </group>
                </page>
            </xpath>
            <field name="uom_id" position="before">
                <field name="price_per_standard_unit" widget="monetary" />
            </field>
        </field>
    </record>

    <record id="product_template_retailer_view_search" model="ir.ui.view">
        <field name="name">product.template.retailer.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Product">
                <field name="barcode" />
                <field
                    name="name"
                    string="Product"
                    filter_domain="['|',('default_code','ilike',self),('name','ilike',self)]"
                />
                <field name="unique_id" string="Bestelnummer-Leveranciernummer" />
                <filter
                    string="Services"
                    name="services"
                    domain="[('type','=','service')]"
                />
                <filter
                    string="Consumable"
                    name="consumable"
                    domain="[('type','=','consu')]"
                    help="Consumable products"
                />
                <separator />
                <filter
                    string="Can be Sold"
                    name="filter_to_sell"
                    domain="[('sale_ok','=',1)]"
                />
                <field
                    name="categ_id"
                    filter_domain="[('categ_id', 'child_of', self)]"
                />
                <field
                    string="Product Variant"
                    name="product_variant_ids"
                    filter_domain="['|', ('product_variant_ids.name','ilike',self), ('product_variant_ids.product_template_attribute_value_ids.attribute_id.name','ilike',self)]"
                />
                <field name="company_id" />
                <field name="product_brand_id" />

                <group expand='0' string='Group by...'>
                    <filter
                        string='Category'
                        domain="[]"
                        name="category"
                        context="{'group_by' : 'categ_id'}"
                    />
                    <filter
                        string='Default Unit of Measure'
                        name="uom"
                        domain="[]"
                        context="{'group_by' : 'uom_id'}"
                    />
                    <filter
                        string='Type'
                        name="type"
                        domain="[]"
                        context="{'group_by' : 'type'}"
                    />
                    <filter
                        string="Available in PoS"
                        name="available_in_pos"
                        domain="[]"
                        context="{'group_by' : 'available_in_pos'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="product_template_retailer_tree_view" model="ir.ui.view">
        <field name="name">product.template.retailer.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree multi_edit="1" sample="1">
                <header>
                    <button
                        string="Print Labels"
                        type="object"
                        name="action_open_label_layout"
                    />
                </header>
                <field name="name" />
                <field name="product_brand_id" />
                <field name="product_quality_id" />
                <field name="uom_id" />
                <field name="standard_price" />
                <field name="list_price" />
                <field name="categ_id" />
                <field name="pos_categ_id" />
                <field name="available_in_pos" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="product_template_retailer_form_view" model="ir.ui.view">
        <field name="name">product.template.retailer.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Retailer view">
                <field name="type" invisible="1" />
                <field name="sale_ok" invisible="1" />
                <field name="is_product_variant" invisible="1" />
                <sheet>
                    <div class="oe_left" style="width: 500px;">
                        <field
                            name="image_1920"
                            widget="image"
                            class="oe_avatar oe_left"
                            readonly="0"
                            modifiers="{}"
                        />
                        <div class="oe_title" style="width: 780px;">
                            <label
                                class="oe_edit_only"
                                for="name"
                                string="Product Name"
                            />
                            <h1>
                                <field
                                    name="name"
                                    class="oe_inline"
                                    modifiers="{'required': true}"
                                />
                            </h1>
                        </div>
                    </div>
                    <notebook>
                        <page name="extended_information" string="Artikelbeheer">
                            <group name="group_top">
                                <group name="group_left">
                                    <field name="detailed_type" />
                                    <field name="available_in_pos" />
                                    <field name="barcode" />
                                    <field name="product_variant_count" invisible="1" />
                                    <field
                                        name="categ_id"
                                        options="{'no_create': True}"
                                    />
                                    <field
                                        name="pos_categ_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="product_brand_id" />
                                    <field name="inhoud" />
                                    <field name="eenheid" />
                                    <field
                                        name="uom_id"
                                        groups="uom.group_uom"
                                        options="{'no_create': True}"
                                    />
                                    <field
                                        name="uom_po_id"
                                        groups="uom.group_uom"
                                        options="{'no_create': True}"
                                    />
                                    <field
                                        name="is_deposit"
                                        attrs="{'invisible': True }"
                                    />
                                    <field
                                        name="deposit_product_id"
                                        string="Statiegeld"
                                        options="{'no_create': True}"
                                        attrs="{
                                            'invisible': ['|', '|', '|', ('is_deposit', '!=', False), ('sale_ok', '=', False), ('type', '=', 'service'), '&amp;', ('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)],
                                        }"
                                    />
                                    <field name="preferred_supplier_id" />
                                </group>
                                <group name="group_right">
                                    <field name="active" />
                                    <field
                                        name="taxes_id"
                                        colspan="2"
                                        widget="many2many_tags"
                                        options="{'no_create': True}"
                                    />
                                    <field name="list_price" />
                                    <field
                                        name="tax_string"
                                        readonly="True"
                                        string=""
                                    />
                                    <field name="standard_price" />
                                    <field
                                        name="margin"
                                        widget="percentage"
                                        digits="[5, 1]"
                                    />
                                    <field name="margin_absolute" />
                                    <field
                                        name="product_quality_id"
                                        options="{'no_create': True}"
                                    />
                                    <field
                                        name="product_origin_id"
                                        options="{'no_create': True}"
                                    />
                                </group>
                            </group>
                            <separator string="Suppliers" />
                            <field name="seller_ids">
                                <tree>
                                    <field name="sequence" widget="handle" />
                                    <field name="partner_id" />
                                    <field name="leveranciernummer" />
                                    <field name="product_name" />
                                    <field name="min_qty" />
                                    <field name="product_code" />
                                    <field name="inkoopprijs" />
                                    <field name="old_consumentenprijs" />
                                    <field name="consumentenprijs" />
                                </tree>
                            </field>
                            <separator string="Import changes" />
                            <field name="cwa_import_product_changes">
                                <tree
                                    default_order="create_date desc"
                                    limit="10"
                                    editable="bottom"
                                    create="false"
                                >
                                    <field name="create_date" readonly="1" />
                                    <button
                                        class="oe_edit_only"
                                        name="update_product_with_latest_changes"
                                        type="object"
                                        icon="fa-refresh"
                                        string="Update the Product Changes"
                                        attrs="{'invisible': [('state', '!=', 'new')]}"
                                    />

                                    <field
                                        name="product_supplierinfo_supplier"
                                        readonly="1"
                                    />
                                    <field name="product_brand_id" readonly="1" />
                                    <field name="changed_fields" readonly="1" />
                                    <field
                                        name="affected_product_id_cost_price"
                                        string="Current cost price"
                                    />
                                    <field
                                        name="affected_product_id_list_price"
                                        string="Current sell price"
                                    />
                                    <field
                                        name="product_supplierinfo_cost_price"
                                        string="Supplier cost price"
                                        readonly="1"
                                    />
                                    <field
                                        name="product_supplierinfo_list_price"
                                        string="Supplier sell price"
                                        readonly="1"
                                    />
                                    <field name="state" />
                                </tree>
                            </field>

                            <!-- From Preferred Supplier -->
                            <separator string="Ingrediënten" />
                            <group name="ingredienten">
                                <field name="ingredients" />
                            </group>
                            <group name="group_top">
                                <group name="group_left">
                                    <field name="proefdiervrij" />
                                    <field name="vegetarisch" />
                                    <field name="d204" />
                                    <field name="d209" />
                                    <field name="d210" />
                                    <field name="d212" />
                                    <field name="d213" />
                                    <field name="d214" />
                                    <field name="d215" />
                                    <field name="d216" />
                                    <field name="d217" />
                                    <field name="d217b" />
                                    <field name="d220" />
                                    <field name="d221" />
                                    <field name="d221b" />
                                    <field name="d222" />
                                    <field name="d223" />
                                </group>
                                <group name="group_right">
                                    <field name="veganistisch" />
                                    <field name="rauwemelk" />
                                    <field name="d225" />
                                    <field name="d226" />
                                    <field name="d228" />
                                    <field name="d230" />
                                    <field name="d232" />
                                    <field name="d234" />
                                    <field name="d235" />
                                    <field name="d236" />
                                    <field name="d237" />
                                    <field name="d238" />
                                    <field name="d238b" />
                                    <field name="d239" />
                                    <field name="d240" />
                                    <field name="d241" />
                                    <field name="d242" />
                                </group>
                            </group>
                            <group name="group_other_information">
                                <separator string="Overige gegevens" />
                                <group name="group_left">
                                    <field name="use_by_days" />
                                    <field name="storage_temperature" />
                                    <field name="usage_tips" />
                                </group>
                                <group name="group_right">
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_template_retailer" model="ir.actions.act_window">
        <field name="name">Retailer view</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_detailed_type': 'product'}</field>
        <field name="search_view_id" ref="product_template_retailer_view_search" />
        <field
            name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('product_template_retailer_tree_view')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('product_template_retailer_form_view')})]"
        />
    </record>

    <menuitem
        name="Artikelbeheer"
        parent="sale.sale_menu_root"
        id="retailer_view_menuitem"
        sequence="5"
        action="action_product_template_retailer"
    />

    <record id="action_make_available_in_pos" model="ir.actions.server">
        <field name="name">Make Available in POS</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="state">code</field>
        <field name="code">
            for record in records:
                record.make_available_in_pos()
        </field>
    </record>

    <!-- Replace Default Kanban with Tree view - Sales -> Products -->
    <record id="sale.product_template_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form,kanban</field>
    </record>
</odoo>
