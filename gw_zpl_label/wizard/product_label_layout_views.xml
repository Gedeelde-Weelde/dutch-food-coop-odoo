<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_label_layout_form_gw_zpl_custom" model="ir.ui.view">
        <field name="name">product.label.layout.form.gw.zpl.custom</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_form" />
        <field name="arch" type="xml">
            <xpath expr='//field[@name="print_format"]' position="after">
                <field
                    name="custom_zpl_report_id"
                    attrs="{'invisible': [('print_format', '!=', 'zpl_custom')]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
