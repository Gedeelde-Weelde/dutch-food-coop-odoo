<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_connection_coin_registration" model="ir.actions.report">
        <field name="name">Connection Coin Registration</field>
        <field name="model">connection.coin.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gw_connection_coin.report_connection_coin_wizard</field>
        <field name="report_file">gw_connection_coin.report_connection_coin_wizard</field>
        <field name="binding_model_id" ref="model_connection_coin_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_connection_coin_wizard">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center">
                            <h2>Connection Coin Registration</h2>
                        </div>
                        <br/>
                        <div class="row">
                            <div class="col-6">
                                <strong>Personal Information</strong>
                                <table class="table table-sm">
                                    <tr>
                                        <td>First Name:</td>
                                        <td><span t-field="doc.firstname"/></td>
                                    </tr>
                                    <tr>
                                        <td>Last Name:</td>
                                        <td><span t-field="doc.lastname"/></td>
                                    </tr>
                                    <tr>
                                        <td>Email:</td>
                                        <td><span t-field="doc.email"/></td>
                                    </tr>
                                    <tr>
                                        <td>Phone:</td>
                                        <td><span t-field="doc.phone"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <strong>Address</strong>
                                <table class="table table-sm">
                                    <tr>
                                        <td>Street:</td>
                                        <td><span t-field="doc.street"/></td>
                                    </tr>
                                    <tr>
                                        <td>ZIP:</td>
                                        <td><span t-field="doc.zip"/></td>
                                    </tr>
                                    <tr>
                                        <td>City:</td>
                                        <td><span t-field="doc.city"/></td>
                                    </tr>
                                    <tr>
                                        <td>Country:</td>
                                        <td><span t-field="doc.country_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <br/>
                        <div class="row">
                            <div class="col-6">
                                <strong>Coin Details</strong>
                                <table class="table table-sm">
                                    <tr>
                                        <td>Date of Issuance:</td>
                                        <td><span t-field="doc.date_issuance"/></td>
                                    </tr>
                                    <tr>
                                        <td>Coin Number:</td>
                                        <td><span t-field="doc.coin_number"/></td>
                                    </tr>
                                    <tr>
                                        <td>Barcode:</td>
                                        <td><span t-field="doc.barcode"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <strong>Bank Details</strong>
                                <table class="table table-sm">
                                    <tr>
                                        <td>Bank Account:</td>
                                        <td><span t-field="doc.bank_account_number"/></td>
                                    </tr>
                                    <tr>
                                        <td>Automatische incasso:</td>
                                        <td>
                                            <t t-if="doc.automatic_debit">Yes</t>
                                            <t t-else="">No</t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <br/>
                        <div class="row mt-5">
                            <div class="col-12" style="border: 1px solid black; min-height: 150px;">
                                <div class="p-2">
                                    <strong>Signature:</strong>
                                    <br/><br/><br/><br/>
                                    <div class="text-right">
                                        ____________________________________
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
