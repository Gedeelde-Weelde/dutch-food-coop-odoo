<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- noupdate="1": scheduling (interval, nextcall, active) is meant to be
         tunable by staff via the UI without a module update reverting it. -->
    <data noupdate="1">
        <record id="ir_cron_connection_coin_reminder" model="ir.cron">
            <field
                name="name"
            >Connection Coin: Verstuur herinnering verlengdatum</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="state">code</field>
            <field name="code">model._cron_send_connection_coin_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
        </record>

        <record id="ir_cron_connection_coin_auto_end" model="ir.cron">
            <field name="name">Connection Coin: Beëindig verlopen coins</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="state">code</field>
            <field name="code">model._cron_end_overdue_connection_coins()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
        </record>
    </data>
</odoo>
