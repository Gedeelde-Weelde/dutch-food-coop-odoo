<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_simple" model="ir.ui.view">
        <field name="name">res.partner.form.simple</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Contact">
                <sheet>
                    <group>
                        <group>
                            <field name="firstname" required="1" />
                            <field name="lastname" required="1" />
                            <field name="company_type" invisible="1" />
                            <field name="is_company" invisible="1" />
                        </group>
                        <group>
                            <label for="street" string="Address" />
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street" />
                                <field name="street2" placeholder="Street 2..." class="o_address_street" />
                                <field name="city" placeholder="City" class="o_address_city" />
                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'zip': zip}" />
                                <field name="zip" placeholder="ZIP" class="o_address_zip" />
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_quick_create': True}" />
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Duplicate check" name="duplicate_check">
                            <field name="same_name_partner_id" invisible="1"/>
                            <div class="alert alert-info" role="alert" attrs="{'invisible': [('same_name_partner_id', '=', False)]}">
                                A contact with the same name already exists: <field name="same_name_partner_id" readonly="1" options="{'no_open': False}"/>
                            </div>
                            <field name="potential_duplicate_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="city"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_partner_simple_form" model="ir.actions.act_window">
        <field name="name">New Individual Contact</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_form_simple" />
        <field name="target">current</field>
        <field name="context">{'default_is_company': False, 'default_company_type': 'person'}</field>
    </record>

    <record id="view_res_partner_filter_inherit" model="ir.ui.view">
        <field name="name">res.partner.select.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Individuals" name="type_person" domain="[('is_company', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_res_partner_simple_form"
              name="New Contact (Simple)"
              action="action_res_partner_simple_form"
              parent="contacts.menu_contacts"
              sequence="1"/>

</odoo>
