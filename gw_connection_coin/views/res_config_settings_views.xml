<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.gw_connection_coin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="pos-loyalty" position="after">
                <div class="col-xs-12 col-lg-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_member_connection_coin_product_id"
                            string="Member Connection Coin Product"
                        />
                        <div class="text-muted">
                            Product added to the order when renewing a member's
                            Connection Coin
                        </div>
                        <field name="pos_member_connection_coin_product_id" />
                    </div>
                </div>
                <div class="col-xs-12 col-lg-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_non_member_connection_coin_product_id"
                            string="Non-Member Connection Coin Product"
                        />
                        <div class="text-muted">
                            Product added to the order when renewing a
                            non-member's Connection Coin
                        </div>
                        <field name="pos_non_member_connection_coin_product_id" />
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
