#. module: gw_connection_coin
#: model:mail.template,body_html:gw_connection_coin.mail_template_connection_coin_ended
msgid ""
"<p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif; \"></p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif; \">\n"
"\n"
"        <span style=\"font-size:14px\">Beste <t t-out='object.firstname or \"\"'></t>,</span>\n"
"        <br>\n"
"\n"
"    </p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif; \">\n"
"      <font style=\"font-size:14px\">\n"
"        <br>\n"
"      </font>\n"
"    </p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">\n"
"      <span style=\"font-size:14px;\">Tot op heden hebben we geen bericht meer van je ontvangen over de verlenging of beëindiging van jouw Connection Coin. We gaan er daarom vanuit dat je er geen gebruik meer van wil maken en hebben dit in onze administratie stopgezet. We vinden het fijn als je de Coin inlevert in onze winkel.</span>\n"
"    </p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">\n"
"      <span style=\"font-size:14px;\">\n"
"        <br>\n"
"      </span>\n"
"    </p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">\n"
"      <span style=\"font-size:14px;\">Mocht je toch nog gebruik willen maken van de Connection Coin, dan kun je dat natuurlijk kenbaar maken bij de kassa.</span></p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">\n"
"      <span style=\"font-size:14px;\">\n"
"        <br>\n"
"      </span>\n"
"    </p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">\n"
"      <span style=\"font-size:14px;\">Bij voorbaat dank en vriendelijke groet,</span>\n"
"    </p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">\n"
"      <span style=\"font-size:14px;\">Edith Schmeits / Robin van Hontem.</span>\n"
"    </p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif; \">\n"
"      <font style=\"font-size:14px\">\n"
"        <img src=\"data:image/png;base64,\" style=\"box-sizing:border-box;border-image-repeat:stretch;border-image-outset:0;border-image-width:1;border-image-slice:100%;border-image-source:none;border-left-color:currentcolor;border-bottom-color:currentcolor;border-right-color:currentcolor;border-top-color:currentcolor;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-style:none;vertical-align:middle; border:0px; width:auto; height:auto;\" width=\"auto\" height=\"90\">\n"
"      </font>\n"
"    </p>\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif; \">\n"
"      <font style=\"font-size:14px\">\n"
"        <b style=\"box-sizing:border-box;font-weight:bold\">\n"
"          <a href=\"https://gedeeldeweelde.nl/\" style=\"box-sizing:border-box;text-decoration:none;background-color:transparent;color:#337ab7; \">www.gedeeldeweelde.nl</a>\n"
"        </b>\n"
"      </font>\n"
"    </p>\n"
"\n"
"\n"
"\n"
"            "
msgstr ""

#. module: gw_connection_coin
#: model:mail.template,body_html:gw_connection_coin.mail_template_connection_coin_reminder
msgid ""
"<p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size: 14px;\"><font style=\"font-size:14px;\">Beste <t t-out=\"object.firstname or ''' '''\"></t>,</font>\n"
"\n"
"    </font></p><p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size: 14px;\">Het is alweer bijna een jaar geleden dat je de Connection Coin van Gedeelde Weelde hebt aangeschaft of verlengd. We willen je daar nogmaals voor bedanken!</font></p>\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"color:#ff671f; font-size: 14px;\">\n"
"        <b style=\"box-sizing:border-box;font-weight:bold;\">Verlengen Connection Coin</b>\n"
"      </font></p>\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size: 14px;\">Jouw Connection Coin loopt af op <t t-out=\"object.cc_renewal_date.strftime('%d-%m-%Y') if object.cc_renewal_date else ''\"></t>. Natuurlijk zouden we het leuk vinden als je de Connection Coin verlengt, zodat je ook na deze datum weer opnieuw een jaar lang kunt genieten van 10% kassakorting op al je boodschappen. Je Connection Coin verlengen kan bij de kassa in de Gedeelde Weelde winkel voor €110,- (of €100,- voor leden). Dus gewoon bij het doen van je volgende boodschappen, wel zo makkelijk!</font>\n"
"    </p><p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\"></p>\n"
"\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size:14px;\">\n"
"        <a style=\"text-decoration:none;box-sizing:border-box;background-color:transparent;cursor:pointer;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-decoration-line:none;color:#337ab7;\" href=\"https://gedeeldeweelde.nl/connectioncoin/\">Hier vind je alles over de Connection Coin nog eens op een rijtje...</a>\n"
"      </font>\n"
"    </p>\n"
"\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"color:#ff671f;font-size: 14px;\">\n"
"        <b style=\"box-sizing:border-box;font-weight:bold;\">Niet verlengen</b>\n"
"      </font>\n"
"    </p>\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size:14px;\">Wil je de Connection Coin niet verlengen, laat ons dat dan even weten als reactie op deze e-mail. Verder vinden we het prettig als je de Connection Coin dan inlevert in de winkel.</font>\n"
"    </p>\n"
"\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"color:#ff671f;font-size: 14px;\">\n"
"        <b style=\"box-sizing:border-box;font-weight:bold;\">2e houder Connection Coin</b>\n"
"      </font>\n"
"    </p>\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size: 14px;\">Wil je een extra coin voor één of meerdere andere personen in je huishouden? Dat kan. Stuur een mail naar connectioncoin@gedeeldeweelde.nl met de volledige naam van deze perso(o)n(en) en jouw eigen coin nummer. Zodra de coin klaar is krijg je een bevestigingsmail dat je deze af kan halen in de winkel. De extra coins kosten eenmalig €10,- per stuk, te betalen aan de kassa bij het ophalen.</font>\n"
"    </p>\n"
"\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"color:#ff671f; font-size: 14px;\">\n"
"        <b style=\"box-sizing:border-box;font-weight:bold;\">Controleren gegevens</b>\n"
"      </font>\n"
"    </p>\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size:14px;\">Voor onze administratie hebben we jouw inschrijfgegevens opgevoerd in onze digitale administratie. Het zou fijn zijn als je deze gegevens kunt controleren en eventuele wijzigingen en aanvullingen als reactie op deze e-mail aan ons doorgeeft. Het gaat om de volgende gegevens:</font>\n"
"    </p>\n"
"\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size:14px;\">Naam: <t t-out=\"object.name or ''' '''\"></t><br>Adres: <t t-out=\"object.street or ''' '''\"></t><br>Postcode: <t t-out=\"object.zip or ''' '''\"></t><br>Woonplaats: <t t-out=\"object.city or ''' '''\"></t><br>Telefoonnummer: <t t-out=\"object.phone or ''' '''\"></t><br>Mobiel: <t t-out=\"object.mobile or ''' '''\"></t></font></p>\n"
"\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size:14px;\">Nogmaals dank voor je vertrouwen en tot ziens in de winkel!</font>\n"
"    </p>\n"
"\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size:14px;\">Hartelijke groet,</font>\n"
"    </p>\n"
"\n"
"    <p style=\"box-sizing:border-box;margin:0px;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">\n"
"      <span style=\"font-size:14px;\">Edith Schmeits / Robin van Hontem</span>\n"
"      <br>\n"
"      <br>\n"
"    </p>\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size:14px;\">\n"
"        <img height=\"90\" width=\"auto\" style=\"box-sizing:border-box;border-image-repeat:stretch;border-image-outset:0;border-image-width:1;border-image-slice:100%;border-image-source:none;border-left-color:currentcolor;border-bottom-color:currentcolor;border-right-color:currentcolor;border-top-color:currentcolor;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-style:none;vertical-align:middle;border: 0px; width: auto; height: auto;\" src=\"data:image/png;base64,\">\n"
"      </font>\n"
"    </p>\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-inline-end:0px;margin-inline-start:0px;margin-block-end:1em;margin-block-start:0px;\">\n"
"      <font style=\"font-size:14px;\">\n"
"        <b style=\"box-sizing:border-box;font-weight:bold;\">\n"
"          <a style=\"text-decoration:none;box-sizing:border-box;background-color:transparent;cursor:pointer;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-decoration-line:none;color:#337ab7;\" href=\"https://gedeeldeweelde.nl/\">www.gedeeldeweelde.nl</a></b></font></p>\n"
"            "
msgstr ""

