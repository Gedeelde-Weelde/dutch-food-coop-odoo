<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-extend="CustomerFacingDisplayHead">
        <t t-jquery=".resources" t-operation="append">
            <link
                rel="stylesheet"
                type="text/css"
                t-att-href="origin + '/gw_connection_coin/static/src/css/customer_facing_display.css'"
            />
        </t>
    </t>

    <t t-extend="CustomerFacingDisplayOrder">
        <t t-jquery=".pos-company_logo" t-operation="after">
            <div t-if="order and order.has_discount()" class="gw-cc-discount-banner" />
        </t>
        <t t-jquery=".pos-total" t-operation="before">
            <div t-if="order and order.has_discount()" class="gw-cc-discount-summary">
                <div class="gw-cc-discount-summary-line">
                    <div><span>Subtotal</span></div>
                    <div>
                        <span
                            t-esc="pos.format_currency(order.get_total_before_discount())"
                        />
                    </div>
                </div>
                <div class="gw-cc-discount-summary-line">
                    <div><span>Coin Discount</span></div>
                    <div>
                        <span t-esc="pos.format_currency(order.get_discount_total())" />
                    </div>
                </div>
            </div>
        </t>
    </t>

</templates>
