<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension" owl="1">
        <xpath expr="//tr//td[hasclass('partner-line-email')]" position="after">
            <td t-if="!env.isMobile">
                <t t-if="hasConnectionCoin">
                    <div class="gw-cc-forgotten-count" title="Keer coin vergeten">
                        <span>Forgotten count: </span><t
                            t-esc="props.partner.cc_forgotten or 0"
                        /> <span>/ 3</span>
                    </div>
                    <button
                        t-if="hasValidConnectionCoin"
                        class="gw-cc-activate-button"
                        t-on-click.stop="onClickActivateCoin"
                    >
                        Activate Connection Coin Discount
                    </button>
                    <div t-else="" class="gw-cc-invalid-note">
                        <span>Connection Coin invalid</span>
                    </div>
                </t>
            </td>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.PartnerListScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//thead//th[hasclass('partner-line-email')]" position="after">
            <th t-if="!env.isMobile">Connection Coin</th>
        </xpath>
    </t>

</templates>
