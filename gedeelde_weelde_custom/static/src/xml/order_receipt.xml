<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="before">
            <div class="pos-receipt-amount">
                SUBTOTAAL
                <span t-esc="env.pos.format_currency(receipt.total_without_discount_lines)" class="pos-receipt-right-align"/>
            </div>
            <div class="pos-receipt-amount">
                KORTING
                <span t-esc="env.pos.format_currency(receipt.total_of_discount_lines)" class="pos-receipt-right-align"/>
            </div>
            <br/>
            <br/>
        </xpath>
    </t>
</templates>
