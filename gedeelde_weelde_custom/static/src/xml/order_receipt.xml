<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="before">
            <div class="pos-receipt-amount">
                SUBTOTAAL
                <span t-esc="env.pos.format_currency(receipt.total_without_discount_lines)" class="pos-receipt-right-align"/>
            </div>
            <div class="pos-receipt-amount">
                KORTING
                <span t-esc="env.pos.format_currency(receipt.total_of_discount_lines)" class="pos-receipt-right-align"/>
            </div>
            <br/>
            <br/>
        </xpath>
    </t>
    <t t-inherit="point_of_sale.OrderLinesReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-if='isSimple(line)']" position="replace">
            <t t-if="isSimple(line)">
                <t t-if="! line.is_discount">
                    <div class="responsive-price">
                        <t t-esc="line.product_name_wrapped[0]" />
                        <span t-esc="env.pos.format_currency_no_symbol(line.price_display)" class="price_display pos-receipt-right-align"/>
                    </div>
                    <WrappedProductNameLines line="line" />
                </t>
            </t>

        </xpath>
    </t>
</templates>
