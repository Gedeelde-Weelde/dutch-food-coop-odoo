<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <!-- Override the customer facing display order line template -->
    <t t-inherit="point_of_sale.CustomerFacingDisplayOrderLines" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos_orderlines')]" position="replace">
            <div class="pos_orderlines">
                <div class="pos_orderlines_item pos_orderlines_header">
                    <div/>
                    <div/>
                    <div>Quantity</div>
                    <div>Price</div>
                </div>
                <div class="pos_orderlines_list">
                    <t t-if="order">
                        <div t-foreach="order.get_orderlines()" t-as="orderline" class="pos_orderlines_item">
                            <div><div t-attf-style="background-image:url(#{productImages[orderline.product.id]})"/></div>
                            <div>
                                <t t-esc="orderline.get_full_product_name()"/>
                                <t t-if="orderline.discount > 0">
                                    <span class="pos_orderline_list_discount"> (-<t t-esc="orderline.discount"/>%)</span>
                                </t>
                            </div>
                            <div t-esc="orderline.get_quantity_str()"/>
                            <div t-esc="pos.format_currency(orderline.get_display_price())"/>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
    <t t-name="CustomerFacingDisplayHead" t-inherit="point_of_sale.CustomerFacingDisplayHead" t-inherit-mode="extension">
    <xpath expr="//div[@class='resources']" position="inside">
        <style>
            .pos_orderline_list_discount {
                color: #ff671f;
                font-weight: bold;
            }
        </style>
    </xpath>
</t>

</templates>
