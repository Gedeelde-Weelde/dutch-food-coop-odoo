<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend the product.template form view -->
    <record id="product_template_form_view_inherit_gedeelde_weelde" model="ir.ui.view">
        <field name="name">product.template.form.inherit.gedeelde.weelde</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <!-- Add the is_bio_basic field to the product form -->
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="is_bio_basic" />
            </xpath>
        </field>
    </record>

    <!-- Extend the product.template.retailer.form view -->
    <record
        id="product_template_retailer_form_view_inherit_gedeelde_weelde"
        model="ir.ui.view"
    >
        <field
            name="name"
        >product.template.retailer.form.inherit.gedeelde.weelde</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="product_import_cwa.product_template_retailer_form_view"
        />
        <field name="arch" type="xml">
            <!-- Add the is_bio_basic field before the eancode field -->
            <xpath expr="//field[@name='available_in_pos']" position="after">
                <field name="is_bio_basic" />
            </xpath>
        </field>
    </record>
</odoo>
